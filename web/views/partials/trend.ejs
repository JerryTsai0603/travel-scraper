<%
  // Build last 7 days (oldest → newest), zero-filling missing dates
  const days = [];
  const today = new Date();
  today.setHours(0, 0, 0, 0);
  const dateMap = new Map((stats.dates || []).map(function(d) { return [d[0], d[1]]; }));
  for (let i = 6; i >= 0; i -= 1) {
    const d = new Date(today);
    d.setDate(today.getDate() - i);
    const key = d.toISOString().slice(0, 10);
    days.push({ date: key, count: dateMap.get(key) || 0 });
  }
  const max = Math.max(1, ...days.map(function(d) { return d.count; }));
  const W = 640, H = 180, P = 28;
  const innerW = W - P * 2;
  const innerH = H - P * 2;
  const stepX = innerW / Math.max(1, days.length - 1);
  const points = days.map(function(d, i) {
    const x = P + i * stepX;
    const y = P + innerH - (d.count / max) * innerH;
    return { x: x, y: y, count: d.count, date: d.date };
  });
  const path = points.map(function(p, i) {
    return (i === 0 ? 'M' : 'L') + p.x.toFixed(1) + ',' + p.y.toFixed(1);
  }).join(' ');
  const areaPath = path + ' L' + (P + innerW).toFixed(1) + ',' + (P + innerH) + ' L' + P + ',' + (P + innerH) + ' Z';
%>
<section class="trend">
  <div class="trend-head">
    <h2>最近 7 天趨勢</h2>
    <div class="trend-meta">
      <span>總計 <strong><%= days.reduce(function(a,b){return a+b.count;}, 0) %></strong> 筆</span>
      <span>峰值 <strong><%= max %></strong> 筆/日</span>
    </div>
  </div>
  <svg viewBox="0 0 <%= W %> <%= H %>" class="trend-svg" role="img" aria-label="最近 7 天命中影片數">
    <defs>
      <linearGradient id="trendFill" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0%" stop-color="rgba(255,111,145,0.5)" />
        <stop offset="100%" stop-color="rgba(255,111,145,0.0)" />
      </linearGradient>
    </defs>
    <% [0, 0.25, 0.5, 0.75, 1].forEach(function(t) { %>
      <line class="grid" x1="<%= P %>" x2="<%= W - P %>" y1="<%= P + innerH * t %>" y2="<%= P + innerH * t %>" />
    <% }); %>
    <path d="<%= areaPath %>" fill="url(#trendFill)" />
    <path d="<%= path %>" fill="none" stroke="var(--accent)" stroke-width="2" />
    <% points.forEach(function(p) { %>
      <g class="pt">
        <circle cx="<%= p.x %>" cy="<%= p.y %>" r="4" fill="var(--accent)" />
        <text x="<%= p.x %>" y="<%= P - 6 %>" text-anchor="middle"><%= p.count %></text>
        <text x="<%= p.x %>" y="<%= H - 6 %>" text-anchor="middle" class="date"><%= p.date.slice(5) %></text>
      </g>
    <% }); %>
  </svg>
</section>
