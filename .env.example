# Optional environment overrides (loaded by src/lib/config.js)
# Leave values empty to fall back to config.json

# Override HTTP user agent
# HTTP_USER_AGENT="Mozilla/5.0 ..."

# Optional: Telegram bot notification on new matches (leave blank to disable)
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# Optional: Discord webhook
# DISCORD_WEBHOOK_URL=

# Optional: run as a long-lived scheduler; "false" runs once and exits
# DAILY_SCRAPER_DAEMON=true
